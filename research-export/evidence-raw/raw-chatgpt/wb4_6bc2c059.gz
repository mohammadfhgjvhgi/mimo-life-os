        "https://help-center-cdn.oaistatic.com/assets/X-sDe9L4_B.js",
        "https://help-center-cdn.oaistatic.com/assets/types-D5HeqEar.js",
        "https://help-center-cdn.oaistatic.com/assets/index-1Dla9cpB.js",
        "https://help-center-cdn.oaistatic.com/assets/Workspace-BnZETrUA.js"
      ],
      "css": [
        "https://help-center-cdn.oaistatic.com/assets/layout-B3R_oMNK.css",
        "https://help-center-cdn.oaistatic.com/assets/use-is-client-CQZ2tRXz.css"
      ]
    }
  },
